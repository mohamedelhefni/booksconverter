{
  "name": "Shelf: ebook library, converter and reader",
  "short_name": "Shelf",
  "description": "Convert and read EPUB, KFX, AZW3 and MOBI books offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f2eb",
  "theme_color": "#f6f2eb",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [{
    "action": "./",
    "accept": {
      "application/epub+zip": [".epub"],
      "application/x-mobipocket-ebook": [".mobi", ".azw", ".azw3"],
      "application/octet-stream": [".kfx"]
    }
  }],
  "launch_handler": { "client_mode": "focus-existing" }
}
